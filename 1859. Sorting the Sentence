class Solution {
    public String sortSentence(String s) {
        String[] words = s.split(" ");
        String[] result = new String[words.length];

        for (String word : words) {
            int index = word.charAt(word.length() - 1) - '1'; // Convert '1'-'9' to 0-indexed integer
            result[index] = word.substring(0, word.length() - 1); // Extract word without the digit
        }

        return String.join(" ", result);
    }
}
