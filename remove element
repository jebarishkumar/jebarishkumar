class Solution {
    public int removeElement(int[] nums, int val) {
        int k = 0; // Pointer for the position to place the next valid element
        
        for (int i = 0; i < nums.length; i++) {
            if (nums[i] != val) {
                nums[k] = nums[i]; // Place valid element at position k
                k++; // Move the valid element pointer
            }
        }
        
        return k;
    }
}
